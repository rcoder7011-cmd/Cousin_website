# ==============================================================================
# SAIFI INTERIOR HUB — ENVIRONMENT CONFIGURATION TEMPLATE
# Official Domain: saifiinteriorhub.in
# 
# Instructions:
# 1. Copy this file to '.env' (do NOT commit '.env' to git).
# 2. In your Supabase Dashboard (https://supabase.com/dashboard/project/<PROJECT_ID>):
#    - Go to: Project Settings -> API
#    - Copy 'Project URL' into VITE_SUPABASE_URL
#    - Copy 'anon / public key' into VITE_SUPABASE_ANON_KEY
# 3. NEVER put the service_role key into any VITE_* variable.
# ==============================================================================

# Supabase Project REST URL (e.g. https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Publishable Key (safe for client-side use with Row Level Security)
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key-here

